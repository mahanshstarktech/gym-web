{
  "name": "lean-protocol-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lean-protocol-db",
      "database_id": "5bad1801-881f-4a80-bf44-f180461844f4",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "BETTER_AUTH_SECRET": "REPLACE_WITH_RANDOM_SECRET_32_CHARS",
    "CORS_ORIGIN": "https://lean-protocol.pages.dev"
  }
}

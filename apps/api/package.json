{
  "name": "@lean-protocol/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lean-protocol-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply lean-protocol-db"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@lean-protocol/shared": "workspace:*",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250721.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.24.0"
  }
}
